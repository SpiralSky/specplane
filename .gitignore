# the dogfood install of the harness templates: maintainer-local, not tracked
.claude/

# build output
packages/cli/dist/

# dependencies (no trailing slash: a plan worktree links node_modules, and a link is not a directory)
node_modules

# OS
.DS_Store

# logs
*.log
npm-debug.log*

# Local environment secrets; sanitized templates remain reviewable.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local caches and test coverage (not distributable build artifacts).
.cache/
coverage/
.nyc_output/

# generated by the package build from docs/user/ (build-docs, build-ai-docs)
packages/cli/assets/docs/
packages/cli/assets/ai-docs/

# local session log (the maintainer's working notes; not shared)
/HANDOFF.md
